{
  "name": "gamerhub-demo",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "directory": "../dist-cloudflare",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "gamerhub-demo",
    "database_id": "880ffdb0-e6bc-4620-b276-d3a057dbf85d",
    "migrations_dir": "./migrations"
  }],
  "triggers": { "crons": ["17 * * * *"] }
}
